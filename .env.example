# Google Gemini API Key
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here
HUGGINGFACEHUB_API_TOKEN=your-huggingface-api-token-here

# Application
APP_ENV=development

# API Security
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_VALIDATE=10/minute
RATE_LIMIT_READ=30/minute

# Langfuse (optional - for LLM observability via https://cloud.langfuse.com, free tier: 50K traces/month)
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
